{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run PulseAI Desktop App",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run PulseAI (Browser Mode)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--web"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}